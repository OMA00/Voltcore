generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & WALLETS
// ============================================================

model User {
  id                String   @id @default(cuid())
  telegramId        String?  @unique
  email             String?  @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  referralCode      String?  @unique
  referredBy        String?
  referredAt        DateTime?
  lastActiveAt      DateTime @default(now())
  maxConcurrentJobs Int      @default(3)
  emailVerified     Boolean  @default(false)
  createdAt         DateTime @default(now())

  wallet          CreditWallet?
  jobs            Job[]
  apiKeys         ApiKey[] 
  referralsMade   Referral[]  @relation("Referrer")
  referralsUsed   Referral[]  @relation("Referee")
  invoices        Invoice[]
  smes            Sme[]
}

model CreditWallet {
  id        String   @id @default(cuid())
  balance   Float    @default(0)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
}

// ============================================================
// JOBS
// ============================================================

model Job {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  gpuType       String
  requestedHours Float
  costPerHourNGN Float
  totalCostNGN   Float
  status        String   @default("pending")
  jobType       String   @default("gpu")
  providerJobId String?
  providerName  String?
  sshDetails    String?
  endpoint      String?
  prompt        String?
  retryCount    Int      @default(0)
  lastError     String?
  nextRetryAt   DateTime?
  failedAt      DateTime?
  isDeadLetter  Boolean  @default(false)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
}

model DeadLetterJob {
  id            String   @id @default(cuid())
  originalJobId String
  userId        String
  gpuType       String
  errorMessage  String
  errorCode     String?
  attempts      Int
  lastAttemptAt DateTime
  reviewed      Boolean  @default(false)
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
}

// ============================================================
// API KEYS & USAGE
// ============================================================

model ApiKey {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String   @default("default")
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  usageLogs  ApiUsage[]
}

model ApiUsage {
  id        String   @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id])
  modelName String
  tokens    Int
  costNGN   Float
  createdAt DateTime @default(now())
}

// ============================================================
// MODELS & FINE-TUNING
// ============================================================

model Model {
  id               String   @id @default(cuid())
  name             String   @unique
  displayName      String
  provider         String
  baseModel        String
  contextLength    Int      @default(4096)
  pricePer1kTokens Float    @default(2)
  status           String   @default("active")
  description      String?
  createdAt        DateTime @default(now())
  fineTuneJobs     FineTuneJob[]
}

model FineTuneJob {
  id             String   @id @default(cuid())
  modelId        String
  model          Model    @relation(fields: [modelId], references: [id])
  userId         String
  datasetUrl     String
  datasetSize    Int
  status         String   @default("pending")
  progress       Int      @default(0)
  providerJobId  String?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  customModel    CustomModel?
}

// ============================================================
// SME (Day 13-14)
// ============================================================

model Sme {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  industry      String?
  description   String?
  status        String   @default("onboarding")
  apiKey        String?  @unique
  totalTokens   Int      @default(0)
  totalSpentNGN Float    @default(0)
  createdAt     DateTime @default(now())

  customModels CustomModel[]
  datasets     Dataset[]
  usageLogs    SmeUsage[]
}

model Dataset {
  id        String   @id @default(cuid())
  smeId     String
  sme       Sme      @relation(fields: [smeId], references: [id])
  name      String
  fileUrl   String
  fileSize  Int
  rowCount  Int      @default(0)
  format    String   @default("jsonl")
  status    String   @default("uploaded")
  error     String?
  createdAt DateTime @default(now())
}

model CustomModel {
  id            String   @id @default(cuid())
  smeId         String
  sme           Sme      @relation(fields: [smeId], references: [id])
  baseModel     String
  displayName   String
  version       Int      @default(1)
  status        String   @default("pending")
  fineTuneJobId String?  @unique
  fineTuneJob   FineTuneJob? @relation(fields: [fineTuneJobId], references: [id])
  endpoint      String?
  createdAt     DateTime @default(now())
  activatedAt   DateTime?
}

model SmeUsage {
  id        String   @id @default(cuid())
  smeId     String
  sme       Sme      @relation(fields: [smeId], references: [id])
  modelId   String?
  tokens    Int
  costNGN   Float
  source    String   @default("api")
  createdAt DateTime @default(now())
}

// ============================================================
// REFERRALS & INVOICES
// ============================================================

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id])
  refereeId      String   @unique
  referee        User     @relation("Referee", fields: [refereeId], references: [id])
  creditsAwarded Float    @default(0)
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  completedAt    DateTime?
}

model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  jobId       String?
  amountNGN   Float
  description String
  status      String   @default("issued")
  issuedAt    DateTime @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
}

// ============================================================
// CREDIT EXPIRY & NOTIFICATIONS
// ============================================================

model CreditExpiry {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  expiresAt DateTime
  expired   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NotificationLog {
  id     String   @id @default(cuid())
  userId String
  type   String
  sentAt DateTime @default(now())
}

// ============================================================
// OBSERVABILITY (Day 17)
// ============================================================

model ErrorLog {
  id            String   @id @default(cuid())
  level         String
  message       String
  correlationId String?
  metadata      String
  createdAt     DateTime @default(now())
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  level       String   @default("beginner") // beginner, intermediate, advanced
  priceNGN    Float    @default(0)
  duration    Int      @default(0) // minutes
  status      String   @default("draft") // draft, published, archived
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  content     String   @db.Text
  videoUrl    String?
  duration    Int      @default(0) // minutes
  createdAt   DateTime @default(now())

  progress    LessonProgress[]
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      String   @default("active") // active, completed, cancelled
  progress    Int      @default(0) // 0-100
  enrolledAt  DateTime @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([lessonId, userId])
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  issuedAt    DateTime @default(now())
  code        String   @unique // verification code
}