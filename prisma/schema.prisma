generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  telegramId      String   @unique
  firstName       String?
  referralCode    String?  @unique
  referredBy      String?
  referredAt      DateTime?
  lastActiveAt    DateTime @default(now())
  maxConcurrentJobs Int    @default(3)  // Default limit
  createdAt       DateTime @default(now())
  wallet          CreditWallet?
  jobs            Job[]
  apiKeys         ApiKey[]
  referralsMade   Referral[]  @relation("Referrer")
  referralsUsed   Referral[]  @relation("Referee")
  invoices        Invoice[]
}

model CreditWallet {
  id        String   @id @default(cuid())
  balance   Float    @default(0)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
}

model Job {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  gpuType       String
  requestedHours Float
  costPerHourNGN Float
  totalCostNGN   Float
  status        String   @default("pending")
  jobType       String   @default("gpu")
  providerJobId String?
  providerName  String?
  sshDetails    String?
  endpoint      String?
  prompt        String?
  retryCount    Int      @default(0)
  lastError     String?
  nextRetryAt   DateTime?
  failedAt      DateTime?
  isDeadLetter  Boolean  @default(false)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
}

model DeadLetterJob {
  id            String   @id @default(cuid())
  originalJobId String
  userId        String
  gpuType       String
  errorMessage  String
  errorCode     String?
  attempts      Int
  lastAttemptAt DateTime
  reviewed      Boolean  @default(false)
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String   @default("default")
  createdAt DateTime @default(now())
  lastUsed  DateTime?
}

model User {
  id              String   @id @default(cuid())
  telegramId      String   @unique
  firstName       String?
  referralCode    String?  @unique
  referredBy      String?  // referralCode of the user who referred them
  referredAt      DateTime?
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  wallet          CreditWallet?
  jobs            Job[]
  apiKeys         ApiKey[]
  referralsMade   Referral[]  @relation("Referrer")
  referralsUsed   Referral[]  @relation("Referee")
  invoices        Invoice[]
}

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation("Referrer", fields: [referrerId], references: [id])
  refereeId     String   @unique
  referee       User     @relation("Referee", fields: [refereeId], references: [id])
  creditsAwarded Float   @default(0)
  status        String   @default("pending")  // pending, completed
  createdAt     DateTime @default(now())
  completedAt   DateTime?
}

model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  jobId       String?
  amountNGN   Float
  description String
  status      String   @default("issued")  // issued, paid, void
  issuedAt    DateTime @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
}

model CreditExpiry {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  expiresAt   DateTime
  expired     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "low_balance", "referral", "invoice", etc.
  sentAt    DateTime @default(now())
}